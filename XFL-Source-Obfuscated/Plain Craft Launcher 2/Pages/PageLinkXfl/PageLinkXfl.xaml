<UserControl x:Class="PageLinkXfl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource ColorBrushSurfaceWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="联机" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource ColorBrushTextPrimary}" />
            <TextBlock Text="房主在游戏里点「对局域网开放」，启动器会自动识别端口；把联机码发给朋友即可一起玩。"
                       FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrushTextSecondary}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,0,24,16">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                <Border CornerRadius="12" BorderThickness="1" Padding="16,12"
                        Margin="0,0,0,12" Background="{DynamicResource ColorBrushSurfaceCard}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LabCompStatus" Text="联机组件：检查中…" FontSize="14"
                                       Foreground="{DynamicResource ColorBrushTextPrimary}" />
                            <TextBlock x:Name="LabCompTip" Text="首次使用需要下载联机组件（约 31MB）"
                                       FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource ColorBrushTextTertiary}" />
                            <ProgressBar x:Name="BarComp" Height="6" Minimum="0" Maximum="1"
                                         Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnCompDownload" Grid.Column="1" Width="132" Height="38"
                                        Text="下载联机组件" ColorType="Highlight" CornerRadius="10"
                                        LabelFontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border CornerRadius="12" BorderThickness="1" Padding="16,12"
                        Margin="0,0,0,12" Background="{DynamicResource ColorBrushSurfaceCard}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}">
                    <StackPanel>
                        <TextBlock Text="自动识别的局域网房间" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrushTextPrimary}" />
                        <TextBlock x:Name="LabLanStatus" Text="正在监听…（在游戏里点「对局域网开放」后会自动出现）"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushTextSecondary}" />
                        <StackPanel x:Name="PanLanRooms" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" BorderThickness="1" Padding="16,14"
                        Margin="0,0,0,12" Background="{DynamicResource ColorBrushSurfaceCard}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}">
                    <StackPanel>
                        <TextBlock Text="① 我是房主 · 创建房间" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="房间名" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource ColorBrushTextSecondary}" />
                            <local:MyTextBox x:Name="TxtRoomName" Grid.Row="0" Grid.Column="1" Height="34"
                                             FontSize="13" HintText="例如 小福的世界" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="密码" FontSize="13"
                                       VerticalAlignment="Center" Margin="16,0,10,0"
                                       Foreground="{DynamicResource ColorBrushTextSecondary}" />
                            <local:MyTextBox x:Name="TxtRoomPass" Grid.Row="0" Grid.Column="3" Height="34"
                                             FontSize="13" HintText="留空则用默认密码" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏端口" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,10,10,0"
                                       Foreground="{DynamicResource ColorBrushTextSecondary}" />
                            <local:MyTextBox x:Name="TxtRoomPort" Grid.Row="1" Grid.Column="1" Height="34"
                                             Margin="0,10,0,0" FontSize="13"
                                             HintText="自动识别；也可手填，默认 25565" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="16,10,0,0">
                                <local:MyButton x:Name="BtnCreate" Width="120" Height="34" Text="创建房间"
                                                ColorType="Highlight" CornerRadius="9" LabelFontSize="13" />
                                <local:MyButton x:Name="BtnStopHost" Width="100" Height="34" Text="关闭房间"
                                                Margin="8,0,0,0" ColorType="Normal" CornerRadius="9"
                                                LabelFontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PanMyCode" Visibility="Collapsed" CornerRadius="10" Padding="14,12"
                                Margin="0,12,0,0" Background="{DynamicResource ColorBrush7}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="房间短码：" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorBrushTextSecondary}" />
                                    <TextBlock x:Name="LabShortCode" Text="------" FontSize="20" FontWeight="Bold"
                                               Margin="6,0,0,0" Foreground="{DynamicResource ColorBrush3}" />
                                    <TextBlock Text="（可以口述给朋友，配合房间名与密码）" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource ColorBrushTextTertiary}" />
                                </StackPanel>

                                <TextBlock Text="分享码（推荐：一键复制发给朋友，对方粘贴即可进房）" FontSize="12"
                                           Margin="0,12,0,0" Foreground="{DynamicResource ColorBrushTextSecondary}" />
                                <TextBlock x:Name="LabShareCode" Text="—" FontSize="13" Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                                           Foreground="{DynamicResource ColorBrushTextPrimary}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <local:MyButton x:Name="BtnCopyCode" Width="150" Height="34" Text="复制分享码"
                                                    ColorType="Highlight" CornerRadius="9" LabelFontSize="13" />
                                    <TextBlock x:Name="LabHostInfo" FontSize="12" Margin="14,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ColorBrushTextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" BorderThickness="1" Padding="16,14"
                        Background="{DynamicResource ColorBrushSurfaceCard}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}">
                    <StackPanel>
                        <TextBlock Text="② 我是玩家 · 输入联机码进房" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TxtJoinCode" Grid.Column="0" Height="36" FontSize="14"
                                             HintText="粘贴或输入房主给你的联机码（形如 XFL-XXXXX-XXXXX）" />
                            <local:MyButton x:Name="BtnJoin" Grid.Column="1" Width="120" Height="36"
                                            Text="加入房间" Margin="10,0,0,0" ColorType="Highlight"
                                            CornerRadius="9" LabelFontSize="13" />
                        </Grid>
                        <TextBlock x:Name="LabJoinStatus" Text="" FontSize="12" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushTextSecondary}" />
                        <local:MyButton x:Name="BtnLeave" Width="120" Height="34" Text="退出房间"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        ColorType="Normal" CornerRadius="9" LabelFontSize="13" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" BorderThickness="1" Padding="14,10" Margin="0,12,0,0"
                        Background="{DynamicResource ColorBrushSurfaceSunken}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}">
                    <StackPanel>
                        <TextBlock Text="联机日志" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrushTextSecondary}" />
                        <TextBlock x:Name="LabLog" Text="—" FontSize="11.5" Margin="0,6,0,0"
                                   TextWrapping="Wrap" MaxHeight="120"
                                   Foreground="{DynamicResource ColorBrushTextTertiary}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>