<UserControl x:Class="PageBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource ColorBrushSurfaceWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,10,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnBack" Grid.Column="0" Width="56" Height="36" Text="←"
                            ColorType="Normal" CornerRadius="10" LabelFontSize="15"
                            ToolTip="后退" />
            <local:MyButton x:Name="BtnForward" Grid.Column="1" Width="56" Height="36" Text="→"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="15"
                            ToolTip="前进" />
            <local:MyButton x:Name="BtnRefresh" Grid.Column="2" Width="56" Height="36" Text="⟳"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="15"
                            ToolTip="刷新" />
            <local:MyButton x:Name="BtnHome" Grid.Column="3" Width="56" Height="36" Text="⌂"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="15"
                            ToolTip="主页" />
            <local:MyTextBox x:Name="TxtUrl" Grid.Column="4" Height="36" Margin="12,0,0,0"
                             FontSize="14" VerticalAlignment="Center"
                             HintText="输入网址后回车，或直接输入关键词搜索" />
            <local:MyButton x:Name="BtnGo" Grid.Column="5" Width="84" Height="36" Text="前往"
                            Margin="10,0,0,0" ColorType="Highlight" CornerRadius="10"
                            LabelFontSize="14" />
            <local:MyButton x:Name="BtnSmallWin" Grid.Column="6" Width="92" Height="36" Text="小窗"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10"
                            LabelFontSize="13" ToolTip="把当前网页放到可置顶的小窗口里" />
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Border CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource ColorBrushBorderNormal}"
                    Background="{DynamicResource ColorBrushSurfaceCard}">
                <Grid>
                    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
                    <TextBlock x:Name="LabBrowserHint" Text="正在准备浏览器内核…" FontSize="14"
                               TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushTextSecondary}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>