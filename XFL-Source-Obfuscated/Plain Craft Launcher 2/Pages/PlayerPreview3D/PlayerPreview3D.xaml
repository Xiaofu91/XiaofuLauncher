<UserControl x:Class="PlayerPreview3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="210"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource ColorBrushSurfaceSunken}" Margin="0">
            <Grid>
                <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>
                <TextBlock x:Name="LabLoading" Text="正在加载 3D 模型…" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushTextSecondary}"/>
            </Grid>
        </Border>

        <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrushBorderNormal}" Opacity="0.6"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="12,12,12,12">
            <StackPanel>

                <TextBlock Text="模型体型" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrushTextPrimary}"/>
                <Border CornerRadius="16" Padding="3" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Background="{DynamicResource ColorBrush8}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BtnModelClassic" CornerRadius="13" Padding="14,5,14,6" Cursor="Hand"
                                Background="{DynamicResource ColorBrush3}"
                                ToolTip="粗壮型（Classic，手臂 4px）">
                            <TextBlock x:Name="LabModelClassic" Text="粗壮" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"/>
                        </Border>
                        <Border x:Name="BtnModelSlim" CornerRadius="13" Padding="14,5,14,6" Cursor="Hand"
                                Margin="2,0,0,0" Background="Transparent"
                                ToolTip="纤细型（Slim，手臂 3px）">
                            <TextBlock x:Name="LabModelSlim" Text="纤细" FontSize="12.5"
                                       Foreground="{DynamicResource ColorBrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="皮肤" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource ColorBrushTextPrimary}"/>

                <Border x:Name="PanSkinList" CornerRadius="8" Background="{DynamicResource ColorBrushSurfaceSunken}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1"
                        MaxHeight="120" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanSkins"/>
                    </ScrollViewer>
                </Border>

                <local:MyButton x:Name="BtnUploadSkin" HorizontalAlignment="Stretch" Height="32" Margin="0,6,0,0"
                                Text="上传皮肤 PNG" ColorType="Normal" CornerRadius="9" LabelFontSize="12.5"/>

                <TextBlock Text="披风" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource ColorBrushTextPrimary}"/>
                <TextBlock x:Name="LabCapeHint" Text="离线账号不可使用披风" FontSize="11.5" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushTextTertiary}"/>

                <Border x:Name="PanCapeList" CornerRadius="8" Background="{DynamicResource ColorBrushSurfaceSunken}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1"
                        MaxHeight="150" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanCapes"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="当前皮肤" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource ColorBrushTextSecondary}"/>
                <Border x:Name="PanCurrentSkin" CornerRadius="8" Background="{DynamicResource ColorBrushSurfaceSunken}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1"
                        Height="56" Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.15"/>
                    </Border.Effect>
                    <Grid>
                        <Image x:Name="ImgCurrentSkin" Stretch="Uniform" Margin="4"/>
                        <TextBlock x:Name="LabNoSkin" Text="未选择" FontSize="12" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushTextTertiary}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
