<UserControl x:Class="PageMusic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource ColorBrushSurfaceWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,10,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="♪ 网易云音乐" FontSize="17" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource ColorBrush3}" />
            <local:MyTextBox x:Name="TxtMusicSearch" Grid.Column="1" Height="36" FontSize="14"
                             VerticalAlignment="Center" MaxWidth="360"
                             HorizontalAlignment="Left"
                             HintText="搜索歌曲 / 歌手 / 专辑，回车或点「搜索」" />
            <local:MyButton x:Name="BtnMusicSearch" Grid.Column="2" Width="84" Height="36" Text="搜索"
                            Margin="10,0,0,0" ColorType="Highlight" CornerRadius="10" LabelFontSize="14" />
            <local:MyButton x:Name="BtnMusicHome" Grid.Column="3" Width="84" Height="36" Text="发现音乐"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="13" />
            <local:MyButton x:Name="BtnMusicMine" Grid.Column="4" Width="84" Height="36" Text="我的音乐"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="13" />
            <local:MyButton x:Name="BtnMusicRefresh" Grid.Column="5" Width="64" Height="36" Text="刷新"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="13" />
            <local:MyButton x:Name="BtnMusicBrowser" Grid.Column="6" Width="112" Height="36" Text="在浏览器打开"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="13" />
            <local:MyButton x:Name="BtnMusicSmall" Grid.Column="7" Width="92" Height="36" Text="小窗"
                            Margin="8,0,0,0" ColorType="Normal" CornerRadius="10" LabelFontSize="13"
                            ToolTip="把播放器放到可置顶的小窗口里，边听歌边用启动器" />
        </Grid>

        <Border x:Name="PanMusicResultBox" Grid.Row="2" Visibility="Visible"
                Margin="16,0,16,8" CornerRadius="10" BorderThickness="1" Padding="10"
                Background="{DynamicResource ColorBrushSurfaceCard}"
                BorderBrush="{DynamicResource ColorBrushBorderNormal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LabMusicResultTip" Grid.Row="0" FontSize="13" Margin="2,0,0,6"
                           Foreground="{DynamicResource ColorBrushTextSecondary}" Text="搜索歌曲，点击即播放" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanMusicResults" />
                </ScrollViewer>
                <TextBlock x:Name="LabMusicEmpty" Grid.Row="1" Text="输入关键词开始搜索～"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushTextTertiary}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16,0,16,8" CornerRadius="10" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{DynamicResource ColorBrushBorderNormal}"
                Background="{DynamicResource ColorBrushSurfaceCard}">
            <Grid x:Name="PanMusicPlayerHost" MinHeight="70">
                <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
                <TextBlock x:Name="LabMusicHint" Text="点一首歌开始播放（搜索后点击结果即可）" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushTextSecondary}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>