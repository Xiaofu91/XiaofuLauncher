<local:MyPageLeft x:Class="PageLaunchLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d" x:Name="PanBack"
             d:DesignHeight="417.2">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="4" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>
        <Grid Grid.ColumnSpan="5" Grid.Row="1" Margin="20,0" VerticalAlignment="Center" x:Name="PanLogin" Visibility="Collapsed" />
        <Grid Grid.ColumnSpan="5" Margin="20,24,20,-4" Name="PanTypeOne" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ColorBrushSemiTransparent}" CornerRadius="13" MinHeight="27" MaxHeight="27">
                <StackPanel Orientation="Horizontal">
                    <Path Name="PathTypeOne" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0" Stretch="Uniform" Fill="{DynamicResource ColorBrush3}" MaxHeight="16" MaxWidth="16" VerticalAlignment="Center"
                          Data="">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Name="LabTypeOne" Text="" FontSize="14" VerticalAlignment="Center" Grid.Column="1" Foreground="{DynamicResource ColorBrush3}" Margin="15,0,12,0" Grid.ColumnSpan="2" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.ColumnSpan="5" Grid.Row="1" Margin="20,8,20,0" Name="PanType" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyRadioButton x:Name="RadioLoginType5" Tag="LoginType/5" Grid.Column="2" Grid.ColumnSpan="1" ColorType="Highlight" Text="{StaticResource LangLaunchLeftAccountMicrosoft}" Margin="4,0"
                             LogoScale="1" Logo="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" />
            <local:MyRadioButton x:Name="RadioLoginType0" Tag="LoginType/0" Grid.Column="3" Grid.ColumnSpan="1" ColorType="Highlight" Text="{StaticResource LangLaunchLeftAccountOffline}"  Margin="4,0"
                             LogoScale="0.85" Logo="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" />

        </Grid>

        <StackPanel x:Name="PanBrand" Grid.Row="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" Margin="0,7,0,7">
            <TextBlock x:Name="LabXflTitle" Text="Xiaofu Launcher"
                       FontSize="26" FontWeight="Bold" LineHeight="34"
                       Foreground="{DynamicResource ColorBrush3}"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="LabXflClock" Text="获取时间中…"
                       FontSize="12" LineHeight="16" Margin="0,4,0,0"
                       Foreground="{DynamicResource ColorBrushTextSecondary}"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
                       IsHitTestVisible="False"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="5">

            <ScrollViewer x:Name="PanAiScroll" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,8">

                <StackPanel x:Name="PanAiMessages" Width="840" HorizontalAlignment="Center"/>
            </ScrollViewer>
            <TextBlock x:Name="LabAiEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="{DynamicResource ColorBrushGray2}" TextAlignment="Center"
                       Text="你好，我是 Xiaofu AI 助手&#x0a;在下面输入消息，按回车或点「发送」"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,2,24,0" Panel.ZIndex="20">
                <Border x:Name="PanAiProvider" CornerRadius="16" Padding="3"
                        Background="{DynamicResource ColorBrush8}"
                        BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BtnProviderFree" CornerRadius="13" Padding="13,5,13,6" Cursor="Hand"
                                Background="{DynamicResource ColorBrush3}" ToolTip="使用内置免费模型（无需登录）">
                            <TextBlock x:Name="LabProviderFree" Text="免费 AI" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"/>
                        </Border>
                        <Border x:Name="BtnProviderDs" CornerRadius="13" Padding="13,5,13,6" Cursor="Hand"
                                Margin="2,0,0,0" Background="Transparent"
                                ToolTip="使用 DeepSeek 网页版（需要用自己的账号登录一次）">
                            <TextBlock x:Name="LabProviderDs" Text="DeepSeek" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="LabDsStatus" Text="" FontSize="12" VerticalAlignment="Center"
                           Margin="10,0,0,0" Visibility="Collapsed" TextAlignment="Right"
                           Foreground="{DynamicResource ColorBrushTextTertiary}"/>
            </StackPanel>
        </Grid>

        <Border x:Name="PanDsHost" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="5"
                Visibility="Collapsed" Margin="20,34,20,70" CornerRadius="12"
                Background="{DynamicResource ColorBrushSurfaceCard}"
                BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="PanDsView" />
        </Border>

        <Grid x:Name="PanAiInputArea" Grid.Row="2" Grid.ColumnSpan="5" Margin="20,8,20,12">

            <Border x:Name="PanAiInputCard" Width="840" MinHeight="108" HorizontalAlignment="Center" CornerRadius="18"
                    Background="{DynamicResource ColorBrush7}"
                    BorderBrush="{DynamicResource ColorBrushBorderNormal}" BorderThickness="1.5"
                    Padding="16,10,12,8">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="2"
                                      Direction="270" Opacity="0.10" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:MyTextBox x:Name="TxtAiInput" Grid.Row="0" MinHeight="48" FontSize="15"
                                     HasBackground="False" BorderThickness="0" Padding="2,0"
                                     VerticalAlignment="Top" />

                    <TextBlock x:Name="LabAiPlaceholder" Grid.Row="0" Text="给 Xiaofu 发送消息…"
                               FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushTextSecondary}" IsHitTestVisible="False"/>
                    <Grid Grid.Row="1" Margin="0,6,0,0" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BtnAiThink" Grid.Column="0" Height="36" VerticalAlignment="Center" CornerRadius="18" Padding="10,5,12,5"
                                Background="{DynamicResource ColorBrush8}" Cursor="Hand"
                                ToolTip="深度思考：显示模型的思考过程（推理模型才有）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="LabAiThink" Text="深度思考" FontSize="13" Margin="4,0,0,0"
                                           Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BtnAiSearch" Grid.Column="1" Height="36" VerticalAlignment="Center" CornerRadius="18" Padding="10,5,12,5"
                                Margin="8,0,0,0" Background="{DynamicResource ColorBrush8}" Cursor="Hand"
                                ToolTip="智能搜索：每次提问先联网查资料，并在回答中标注来源">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="LabAiSearch" Text="智能搜索" FontSize="13" Margin="4,0,0,0"
                                           Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                <Border x:Name="BtnAiExec" Grid.Column="2" Height="36" VerticalAlignment="Center"
                        HorizontalAlignment="Left" CornerRadius="18" Padding="10,5,12,5"
                        Margin="8,0,0,0" Background="{DynamicResource ColorBrushGray6}" Cursor="Hand"
                        ToolTip="允许执行：开启后 AI 可以帮你启动版本、下载游戏与模组（执行前会列出计划让你确认）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabAiExec" Text="允许执行" FontSize="13" Margin="4,0,0,0"
                                   Foreground="{DynamicResource ColorBrushGray1}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="BtnAiSend" Grid.Column="3" Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource ColorBrush3}" Cursor="Hand"
                                VerticalAlignment="Center" ToolTip="发送（也可按回车）">
                            <Path x:Name="PathAiSend" Data="M 14,23 L 14,7 M 14,7 L 6.5,14.5 M 14,7 L 21.5,14.5"
                                  Stroke="#FFFFFFFF" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
<Grid Grid.ColumnSpan="5" Grid.Row="3" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AprilScaleTrans" />
                    <TranslateTransform x:Name="AprilPosTrans" />
                </TransformGroup>
            </Grid.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0">
                <local:MyButton x:Name="BtnLaunch" Height="48" Width="176"
                                Text="{StaticResource LangLaunchLeftLoadingInstance}"
                                ColorType="Brand" CornerRadius="10"
                                LabelFontSize="15" LabelFontWeight="SemiBold" IsEnabled="False">
                    <local:MyButton.ForeEffect>
                        <DropShadowEffect Color="{DynamicResource ColorObject3}"
                                          BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.22" />
                    </local:MyButton.ForeEffect>
                </local:MyButton>
                <local:MyButton x:Name="BtnVersion" Height="48" Width="152" Margin="12,0,0,0"
                                Text="{StaticResource LangLaunchLeftInstanceChoose}"
                                ColorType="Highlight" CornerRadius="10"
                                LabelFontSize="14" LabelFontWeight="Medium" IsEnabled="False" />
                <local:MyButton x:Name="BtnMore" Visibility="Collapsed"
                                Height="48" Width="140" Margin="12,0,0,0"
                                Text="{StaticResource LangLaunchLeftInstanceConfig}"
                                ColorType="Normal" CornerRadius="10" LabelFontSize="14" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="4" Grid.ColumnSpan="5" x:Name="LabVersion"
                   Text="{StaticResource LangLaunchLeftLoadingInstanceTip}"
                   Margin="20,0,0,0" FontSize="11.5" LineHeight="14"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
    <Grid Name="PanLaunching" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" RenderTransformOrigin="0.5,0.5" Margin="0,-7,0,0">
            <StackPanel.BitmapEffect>
                <DropShadowBitmapEffect Color="{DynamicResource ColorObjectGray2}" ShadowDepth="1.5" Direction="270" Opacity="0.15" Softness="0.15" />
            </StackPanel.BitmapEffect>
            <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="50" Margin="0,10,0,5" />
            <TextBlock Name="LabLaunchingTitle" Margin="15,10,15,0" Text="{StaticResource LangLaunchLeftStartingInstance}" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ColorBrush3}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5" Text="Forge 1.12.2-15.8.0.1560" HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <Grid Height="4" Margin="30,12,30,27" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="ProgressLaunchingFinished" Width="69.28*"/>
                    <ColumnDefinition Name="ProgressLaunchingUnfinished" Width="30.72*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" >
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
            </Grid>
            <Grid HorizontalAlignment="Center" Name="PanLaunchingInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStartingStage}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStageDownloadLib}" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingStage" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStageLogin}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStageMicrosoftAccount}" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingMethod" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStageStarting}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" Name="LabLaunchingProgressLeft" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="69.28 %" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingProgress" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{StaticResource LangLaunchLeftStageDownload}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Opacity="0" Name="LabLaunchingDownloadLeft" Visibility="Collapsed" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="5.2 M/s" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingDownload" Opacity="0" Visibility="Collapsed" />
                <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="5" Grid.RowSpan="2" Width="260" Margin="0,16,0,2" Visibility="Collapsed" Opacity="0">
                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource ColorBrushGray1}" Opacity="0.5">
                        <Border.Clip>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,1000,1000" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="94,0,72,10" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Border.Clip>
                    </Border>
                    <TextBlock FontSize="12.5" Text="{StaticResource LangLaunchLeftTip}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource ColorBrushGray1}" Opacity="0.5" />
                    <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Text="这是一段测试用的小提示文本，它应该足够长以让它有两行。" Margin="11,21,11,10" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </StackPanel>
        <local:MyButton Grid.Row="4" x:Name="BtnCancel" Height="35" Margin="20,0,20,20" VerticalAlignment="Bottom" Text="{StaticResource LangDialogBtnCancel}" />
    </Grid>
</local:MyPageLeft>
