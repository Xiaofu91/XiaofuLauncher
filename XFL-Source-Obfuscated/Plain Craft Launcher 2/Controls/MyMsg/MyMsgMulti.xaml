<Grid x:Class="MyMsgMulti"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
      MinWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushSurfaceDialog}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23" MaxHeight="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="LabTitle" FontSize="21" TextTrimming="None"
                       Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <TextBlock Grid.Row="2" x:Name="LabHint" FontSize="12.5" Margin="0,10,0,0"
                       Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <my:MyScrollViewer Grid.Row="3" VerticalAlignment="Top" x:Name="PanCaption" Margin="0,12,0,17" Padding="7,0,15,0"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
                <StackPanel x:Name="PanSelection" Orientation="Vertical" />
            </my:MyScrollViewer>
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <my:MyButton x:Name="BtnAll" ColorType="Normal" Text="全选" Height="34" Width="74" Margin="0,0,10,0" />
                    <my:MyButton x:Name="BtnNone" ColorType="Normal" Text="全不选" Height="34" Width="88" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <my:MyButton ColorType="Normal" x:Name="Btn2" Text="取消" Height="34" Width="96" Margin="12,0,0,0" />
                    <my:MyButton ColorType="Highlight" x:Name="Btn1" Text="下载所选" Height="34" Width="120" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Grid>
